<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.xjw580.Hearthstone-Script</groupId>
        <artifactId>hs-script</artifactId>
        <version>v4.15.0-GA</version>
    </parent>

    <groupId>club.xiaojiawei</groupId>
    <artifactId>Deck-Plugin-Market</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Deck-Plugin-Market</name>
    <url>http://maven.apache.org</url>

    <modules>
        <module>WeightHanderStrategy</module>
        <module>dropStrategy</module>
        <module>extWeightHandler</module>
        <module>accolades250909</module>
    </modules>

    <repositories>
        <repository>
            <id>mavenCentral</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.code.style>official</kotlin.code.style>
        <java.version>25</java.version>
        <kotlin.compiler.jvmTarget>${java.version}</kotlin.compiler.jvmTarget>
        <kt-version>2.2.0</kt-version>
        <kapt.include.compile>false</kapt.include.compile>
        <sdk-version>v4.9.0-GA</sdk-version>
        <strategy-sdk-version>${hs-script-strategy-sdk-version}</strategy-sdk-version>
        <card-sdk-version>${hs-script-card-sdk-version}</card-sdk-version>
    </properties>


    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kt-version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.github.xjw580</groupId>
            <artifactId>hs-script-base-strategy-plugin</artifactId>
            <version>1.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!--策略SDK-->
        <dependency>
            <groupId>com.github.xjw580</groupId>
            <artifactId>hs-script-strategy-sdk</artifactId>
            <version>${strategy-sdk-version}</version>
        </dependency>
        <!--卡牌SDK-->
        <dependency>
            <groupId>com.github.xjw580</groupId>
            <artifactId>hs-script-card-sdk</artifactId>
            <version>${card-sdk-version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kt-version}</version>
        </dependency>
    </dependencies>
</project>